# 复制为 .env 后按需修改

# —— MVP ——
APP_NAME=KnowledgeScope
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./data/knowledgescope.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SSE_HEARTBEAT_INTERVAL_SECONDS=15
CONTENT_MAX_LENGTH=100000
TITLE_MAX_LENGTH=200
CONTENT_PREVIEW_LENGTH=120

# —— Auth（Phase 2a）——
JWT_SECRET_KEY=dev-only-change-me-knowledgescope
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_HASH_SCHEME=bcrypt
PHONE_REGEX=^1\d{10}$
PHONE_MAX_LENGTH=11

# —— 入库 / 分块（Phase 2b）——
INGEST_WORKER_POLL_INTERVAL_SECONDS=2
INGEST_MAX_RETRY=3
CHUNK_SIZE_CHARS=500
CHUNK_OVERLAP_CHARS=80
CHUNK_MIN_CHARS=20
SOURCE_ERROR_MESSAGE_MAX_LENGTH=2000

# —— web_page（Phase 2c）——
WEB_FETCH_TIMEOUT_SECONDS=15
WEB_FETCH_MAX_BYTES=2097152
WEB_FETCH_USER_AGENT=KnowledgeScopeBot/0.1
WEB_FETCH_ALLOWED_SCHEMES=http,https

# —— 向量库 ——
VECTOR_BACKEND=chroma
VECTOR_PERSIST_DIRECTORY=./data/chroma
VECTOR_COLLECTION_NAME=knowledgescope_chunks
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.0

# —— 问答 ——
ANSWER_MODE_DEFAULT=strict
CHAT_HISTORY_MESSAGE_LIMIT=10
CHAT_MAX_OUTPUT_TOKENS=2048
CITATION_MAX_COUNT=8
CONVERSATION_TITLE_MAX_LENGTH=100
CONVERSATION_TITLE_FROM_QUESTION_PREFIX=30

# —— 上游模型调用（超时与重试） ——
EMBEDDING_REQUEST_TIMEOUT_SECONDS=60
CHAT_REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BACKOFF_SECONDS=1

# —— 系统默认模型（未配置则相关接口报错）——
DEFAULT_CHAT_BASE_URL=
DEFAULT_CHAT_API_KEY=
DEFAULT_CHAT_MODEL=
DEFAULT_EMBEDDING_BASE_URL=
DEFAULT_EMBEDDING_API_KEY=
DEFAULT_EMBEDDING_MODEL=
MODEL_API_KEY_MASK_VISIBLE_SUFFIX=4
MODEL_PROFILE_NAME_MAX_LENGTH=100
MODEL_BASE_URL_MAX_LENGTH=500
