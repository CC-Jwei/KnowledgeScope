{
  "name": "@knowledgescope/shared",
  "version": "0.1.0",
  "private": true,
  "description": "知域 KnowledgeScope 前后端契约层：由 backend OpenAPI 生成 TypeScript 类型",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./generated/openapi": "./generated/openapi.ts",
    "./openapi.json": "./openapi/openapi.json"
  },
  "scripts": {
    "dump:openapi": "node ./scripts/dump-openapi.mjs",
    "generate": "node ./scripts/generate.mjs",
    "generate:from-url": "node ./scripts/generate.mjs --from-url",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.4",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
