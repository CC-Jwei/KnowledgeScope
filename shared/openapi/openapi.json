    "/api/v1/events/heartbeat": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "SSE 心跳流",
        "operationId": "heartbeat_stream_api_v1_events_heartbeat_get",
        "responses": {
          "200": {
            "description": "Server-Sent Events 流（connected + 周期性 heartbeat）",
            "content": {
              "application/json": {
                "schema": {}
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "example": "event: connected\ndata: {\"message\":\"connected\"}\n\nevent: heartbeat\ndata: {\"ts\":\"2026-11-09T06:00:00.000Z\",\"serverTime\":\"2026-11-09T06:00:00.000Z\"}\n\n"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "健康检查",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
