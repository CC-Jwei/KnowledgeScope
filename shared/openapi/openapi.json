  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PlainTextSourceCreate": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Title",
            "description": "可选标题；未传时由服务端生成"
          },
          "content": {
            "type": "string",
            "maxLength": 100000,
            "minLength": 1,
            "title": "Content",
            "description": "纯文字正文"
          },
          "type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SourceType"
              },
              {
                "type": "null"
              }
            ],
            "description": "可选；若传入必须为 plain_text"
          }
        },
        "type": "object",
        "required": [
          "content"
        ],
        "title": "PlainTextSourceCreate"
      },
      "PlainTextSourceUpdate": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Title",
            "description": "标题"
          },
          "content": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Content",
            "description": "纯文字正文"
          }
        },
        "type": "object",
        "title": "PlainTextSourceUpdate"
      },
      "Source": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "workspaceId": {
            "type": "string",
            "title": "Workspaceid"
          },
          "type": {
            "$ref": "#/components/schemas/SourceType"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "$ref": "#/components/schemas/SourceStatus"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "title": "Createdat"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Updatedat"
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content",
            "description": "全文；列表接口通常省略"
          },
          "contentPreview": {
            "type": "string",
            "title": "Contentpreview",
            "description": "列表预览截断文本"
          }
        },
        "type": "object",
        "required": [
          "id",
          "workspaceId",
          "type",
          "title",
          "status",
          "createdAt",
          "updatedAt",
          "contentPreview"
        ],
        "title": "Source"
      },
      "SourceListItem": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "workspaceId": {
            "type": "string",
            "title": "Workspaceid"
          },
          "type": {
            "$ref": "#/components/schemas/SourceType"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "$ref": "#/components/schemas/SourceStatus"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "title": "Createdat"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Updatedat"
          },
          "contentPreview": {
            "type": "string",
            "title": "Contentpreview"
          }
        },
        "type": "object",
        "required": [
          "id",
          "workspaceId",
          "type",
          "title",
          "status",
          "createdAt",
          "updatedAt",
          "contentPreview"
        ],
        "title": "SourceListItem",
        "description": "列表项：不含全文 content。"
      },
      "SourceStatus": {
        "type": "string",
        "enum": [
          "ready",
          "pending",
          "processing",
          "failed"
        ],
        "title": "SourceStatus",
        "description": "来源处理状态。MVP 创建后直接为 ready。"
      },
      "SourceType": {
        "type": "string",
        "enum": [
          "plain_text",
          "web_page",
          "video_url",
          "image",
          "image_url",
          "markdown",
          "pdf",
          "word",
          "excel",
          "powerpoint"
        ],
        "title": "SourceType",
        "description": "来源类型。创建接口仅允许 plain_text，其余为后续预留。"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Workspace": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "title": "Createdat"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Updatedat"
          },
          "sourceCount": {
            "type": "integer",
            "title": "Sourcecount",
            "description": "该空间下来源数量"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "createdAt",
          "updatedAt",
          "sourceCount"
        ],
        "title": "Workspace"
      },
      "WorkspaceCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "description": "知识空间名称"
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Description",
            "description": "可选描述"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "WorkspaceCreate"
      },
      "WorkspaceUpdate": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Name",
            "description": "知识空间名称"
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Description",
            "description": "可选描述；传 null 可清空"
          }
        },
        "type": "object",
        "title": "WorkspaceUpdate"
      },
      "ConnectedEvent": {
        "properties": {
          "message": {
            "default": "connected",
            "description": "连接成功提示",
            "title": "Message",
            "type": "string"
          }
        },
        "title": "ConnectedEvent",
        "type": "object"
      },
      "HeartbeatEvent": {
        "properties": {
          "ts": {
            "description": "心跳时间戳（UTC）",
            "format": "date-time",
            "title": "Ts",
            "type": "string"
          },
          "serverTime": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "可选服务端时间，与 ts 一致时可省略",
            "title": "Servertime"
          }
        },
        "required": [
          "ts"
        ],
        "title": "HeartbeatEvent",
        "type": "object"
      }
    }
  }
}
